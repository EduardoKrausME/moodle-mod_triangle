{{!
    @template mod_triangle/calculator

    Example context (json):
    {
        Aqui tem que criar o context em inglês
    }
}}
<div id="{{id}}" class="mod-triangle-calculator" data-waiting="{{waiting}}">
    <div class="triangle-toolbar">
        <p class="triangle-hint">{{hint}}</p>
        <button type="button" class="btn btn-secondary triangle-clear">{{clear}}</button>
    </div>

    <div class="triangle-stage" aria-label="Calculadora geométrica de triângulo">
        <svg class="triangle-svg" viewBox="0 0 640 440" role="img" aria-label="Triângulo calculado">
            <polygon class="triangle-shape" points="110,350 530,350 320,80"></polygon>
            <circle class="triangle-vertex triangle-vertex-a" cx="110" cy="350" r="5"></circle>
            <circle class="triangle-vertex triangle-vertex-b" cx="530" cy="350" r="5"></circle>
            <circle class="triangle-vertex triangle-vertex-c" cx="320" cy="80" r="5"></circle>
            <text class="triangle-point-label label-a" x="90" y="378">A</text>
            <text class="triangle-point-label label-b" x="540" y="378">B</text>
            <text class="triangle-point-label label-c" x="320" y="62">C</text>
        </svg>

        <label class="triangle-side-input side-a-wrap">
            <span class="accesshide">{{sidea}}</span>
            <input class="form-control triangle-input triangle-side" type="number" inputmode="decimal" step="any" min="0.000001" max="1000000000000" data-field="a" placeholder="a">
        </label>
        <label class="triangle-side-input side-b-wrap">
            <span class="accesshide">{{sideb}}</span>
            <input class="form-control triangle-input triangle-side" type="number" inputmode="decimal" step="any" min="0.000001" max="1000000000000" data-field="b" placeholder="b">
        </label>
        <label class="triangle-side-input side-c-wrap">
            <span class="accesshide">{{sidec}}</span>
            <input class="form-control triangle-input triangle-side" type="number" inputmode="decimal" step="any" min="0.000001" max="1000000000000" data-field="c" placeholder="c">
        </label>

        <label class="triangle-angle-input angle-a-wrap">
            <span class="triangle-angle-name">A</span>
            <input class="form-control triangle-input triangle-angle" type="number" inputmode="decimal" step="any" min="0.01" max="179.99" data-field="A" placeholder="°">
            <span class="triangle-degree">°</span>
        </label>
        <label class="triangle-angle-input angle-b-wrap">
            <span class="triangle-angle-name">B</span>
            <input class="form-control triangle-input triangle-angle" type="number" inputmode="decimal" step="any" min="0.01" max="179.99" data-field="B" placeholder="°">
            <span class="triangle-degree">°</span>
        </label>
        <label class="triangle-angle-input angle-c-wrap">
            <span class="triangle-angle-name">C</span>
            <input class="form-control triangle-input triangle-angle" type="number" inputmode="decimal" step="any" min="0.01" max="179.99" data-field="C" placeholder="°">
            <span class="triangle-degree">°</span>
        </label>
    </div>

    <div class="triangle-message alert alert-info" role="status">{{waiting}}</div>

    <div class="triangle-output" hidden>
        <h3>{{results}}</h3>
        <div class="triangle-results"></div>
        <h3>{{calculations}}</h3>
        <div class="triangle-calculations"></div>
    </div>
</div>
