{{!
    @template mod_triangle/results

    Example context (json):
    {
        "resultstitle": "Results",
        "calculationstitle": "Calculations",
        "cards": [
            {"label": "Side a", "value": "3"}
        ],
        "calculationrows": [
            {"text": "Perimeter: P = a + b + c = 12"}
        ]
    }
}}
<h3>{{resultstitle}}</h3>
<div class="triangle-results">
    {{#cards}}
        <div class="triangle-result-card">
            <span class="triangle-result-label">{{label}}</span>
            <span class="triangle-result-value">{{value}}</span>
        </div>
    {{/cards}}
</div>

<h3>{{calculationstitle}}</h3>
<div class="triangle-calculations">
    {{#calculationrows}}
        <div class="triangle-calculation-row">{{text}}</div>
    {{/calculationrows}}
</div>
